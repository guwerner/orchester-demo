@band = http://localhost:4004/band 

### Get all Bands
GET {{band}}/Band?$top=20
Accept: application/json

### Get a Band by ID
GET {{band}}/Band(660e8400-e29b-41d4-a716-446655440001)
Accept: application/json

### Create a new Band
POST {{band}}/Band
Content-Type: application/json

{
  "bandName": "Test Band",
  "genre": "Indie",
  "foundedIn": "2020-01-01"
}

### Update a Band
PATCH {{band}}/Band(660e8400-e29b-41d4-a716-446655440001)
Content-Type: application/json

{
  "genre": "Classical"
}

### Delete a Band
DELETE {{band}}/Band(660e8400-e29b-41d4-a716-446655440001)

### Get Musiacn of a Band by Band ID
get {{band}}/Band(660e8400-e29b-41d4-a716-446655440002)/to_musican?$expand=to_musican
Accept-Language: : application/json

### Get Band2Musican of a Band by Band ID
get {{admin}}/Band(660e8400-e29b-41d4-a716-446655440002)/to_musican
Accept-Language: : application/json