@musican = http://localhost:4004/musican

### Get all Stages
GET {{musican}}/Stage?$top=20
Accept: application/json

### Get Stage by ID
GET {{musican}}/Stage(stage-1)
Accept: application/json

### Create Stage
POST {{musican}}/Stage
Content-Type: application/json

{
  "name": "Test Venue",
  "location": "Test City",
  "capacity": 1234,
  "description": "Test description"
}

### Update Stage
PATCH {{musican}}/Stage(stage-1)
Content-Type: application/json

{
  "capacity": 2000
}

### Delete Stage
DELETE {{musican}}/Stage(stage-1)
